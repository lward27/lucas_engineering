#!/bin/sh
set -eu

exec /usr/local/lib/buildkit/current/bin/buildctl \
  --addr tcp://192.168.50.145:12341 \
  --tlsservername buildkit-talos.lucas.internal \
  --tlscacert /etc/buildkit/talos/pki/ca.pem \
  --tlscert /etc/buildkit/talos/pki/operator-cert.pem \
  --tlskey /etc/buildkit/talos/pki/operator-key.pem \
  "$@"
